{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next",
        "runtime": "nodejs18.x"
      }
    },
    {
      "src": "backend/package.json",
      "use": "@vercel/node",
      "config": {
        "distDir": "backend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/dist/main.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    {
      "src": "/ProductDetail/(?<id>[^/]+)",
      "dest": "/frontend/ProductDetail/[id]",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1",
      "continue": true
    }
  ],
  "overrides": {
    "frontend/ProductDetail/*": {
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  }
}