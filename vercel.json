{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/next",
        "config": { "distDir": ".next" }
      },
      {
        "src": "backend/src/main.ts",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "backend/src/main.ts"
      },
      {
        "src": "/(.*)",
        "dest": "frontend/$1",
        "headers": { "x-matched-path": "/$1" }
      }
    ]
  }